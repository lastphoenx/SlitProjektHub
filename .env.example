# Kopieren: cp .env.example .env — nur lokal auf dem Server/PC, nie committen.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Lokales Ollama (EVO) — eine der Variablen reicht
# OLLAMA_BASE_URL=http://192.168.131.60:11434
# OLLAMA_URL=http://192.168.131.60:11434
OLLAMA_BASE_URL=
OLLAMA_API_KEY=ollama

# Cloud-PII Stufe 2 (Presidio+Flair). 0 = nur Regex-Stufe 1
SWISS_PII_ANONYMIZER=1
# Nach prefetch_pii_models.py — kein HF-Download im Laufzeitbetrieb
HF_HUB_OFFLINE=1
# HuggingFace-Hub-Cache unter APP_ROOT (systemd ProtectHome blockiert ~/.cache)
# Enthält flair/ner-german-large + FacebookAI/xlm-roberta-large (Basis für large)
HF_HOME=/opt/slitprojekthub/.hf_cache
# Kleineres NER ohne xlm-roberta (Firewall/4GB-RAM): flair/ner-german
# FLAIR_NER_MODEL=flair/ner-german-large
# Sekunden Stufe-2-Fallback nach Fehler (Default 300)
# PII_CIRCUIT_BREAKER_SECONDS=300

# Optional: öffentliche App-URL(s) für CORS (kommagetrennt)
# PUBLIC_APP_ORIGINS=https://hub.example.com
