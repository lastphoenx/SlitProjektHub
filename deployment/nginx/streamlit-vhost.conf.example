# Optional: Streamlit-UI (:8501) — z. B. hub2.santinel.li
# BACKEND_HOST = LAN-IP des App-Hosts
# PUBLIC_HOST  = öffentlicher FQDN

server {
    listen 80;
    server_name PUBLIC_HOST;

    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root /etc/nginx/renew-ssl/www;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name PUBLIC_HOST;

    access_log /var/log/nginx/PUBLIC_HOST.access.log main;
    error_log  /var/log/nginx/PUBLIC_HOST.error.log warn;

    ssl_certificate     /etc/letsencrypt/live/PUBLIC_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/PUBLIC_HOST/privkey.pem;

    include snippets/ssl-hardening-ecdsa.conf;
    include snippets/security-headers.conf;

    client_max_body_size 200m;

    location /_stcore/stream {
        proxy_pass         http://BACKEND_HOST:8501;
        include            snippets/proxy-headers.conf;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering    off;
    }

    location /_stcore/health {
        proxy_pass         http://BACKEND_HOST:8501;
        include            snippets/proxy-headers.conf;
    }

    location / {
        proxy_pass         http://BACKEND_HOST:8501;
        include            snippets/proxy-headers.conf;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_buffering    off;
    }
}
